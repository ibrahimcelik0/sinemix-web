# SineMix Yapılandırma Dosyası (.env.example)
SECRET_KEY=sinemix-gelistirme-gizli-anahtari
FLASK_ENV=development

# TMDB API Anahtarınızı buraya ekleyin (https://www.themoviedb.org/settings/api)
# Boş bırakılırsa yerleşik yerel katalog (data/catalog.json) otomatik devreye girer.
TMDB_API_KEY=

# Şifresiz (Passwordless) 6 Haneli OTP E-Posta Gönderimi (Gmail SMTP / Uygulama Şifresi)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=
